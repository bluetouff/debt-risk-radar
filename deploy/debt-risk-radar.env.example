# Copy to /etc/debt-risk-radar.env on Debian.
# Owner root:debt-radar, mode 640. Never overwrite existing production secrets.

# Required for the 19 FRED signals in methodology 2.0.
FRED_API_KEY=
# Legacy MASSIVE_* settings are no longer read by the public app or exporter.

DEBT_RISK_RADAR_LATEST_JSON=/var/www/debt-risk-radar/latest.json
DEBT_RISK_RADAR_LATEST_JSON_TOP_SIGNALS=20
DEBT_RISK_RADAR_CACHE_DIR=/var/lib/debt-risk-radar/cache

STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_ENABLE_CORS=true
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=none
